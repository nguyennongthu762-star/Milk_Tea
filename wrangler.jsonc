{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "milk-tea-shop",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets": {
    "required": [
      "TURSO_DATABASE_URL",
      "TURSO_AUTH_TOKEN",
      "AUTH_SECRET"
    ]
  }
}
